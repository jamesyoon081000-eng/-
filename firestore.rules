rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 내 진행상황: 본인만 읽고 쓰기
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 명예의 전당 (매달 시즌): 누구나 보기, 이번 달 시즌에만 본인 기록을 더 좋을 때 올리기
    match /seasons/{sid}/scores/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && sid == currentSeason() && valid();
      allow update: if isOwner(uid) && sid == currentSeason() && valid() && (
        request.resource.data.days > resource.data.days ||
        (request.resource.data.days == resource.data.days &&
         request.resource.data.money > resource.data.money));
      allow delete: if isAdmin();
    }

    // 한국 시간 기준 "YYYY-MM"
    function currentSeason() {
      let t = request.time + duration.value(9, 'h');
      let m = t.month();
      return string(t.year()) + '-' + (m < 10 ? '0' + string(m) : string(m));
    }

    // 관리자: 이메일 인증된 이 계정들만 (Google 로그인 권장). index.html의 ADMIN_EMAILS와 같게 유지
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ["jamesyoon081000@gmail.com", "soo0106b.com@gmail.com"]
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function valid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'days', 'money', 'at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 16
        && d.days is int && d.days >= 0 && d.days <= 100000
        && d.money is int && d.money >= 0 && d.money <= 100000000000
        && d.at is timestamp;
    }
  }
}
