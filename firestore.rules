rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 내 진행상황: 본인만 읽고 쓰기
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 명예의 전당: 누구나 보기, 본인 기록만 더 좋을 때 올리기
    match /scores/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && valid();
      allow update: if isOwner(uid) && valid() && (
        request.resource.data.days > resource.data.days ||
        (request.resource.data.days == resource.data.days &&
         request.resource.data.money > resource.data.money));
      allow delete: if isAdmin();
    }

    // 관리자: 이메일 인증된 이 계정만 (Google 로그인 권장)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "jamesyoon081000@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function valid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'days', 'money', 'at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 16
        && d.days is int && d.days >= 0 && d.days <= 100000
        && d.money is int && d.money >= 0 && d.money <= 100000000000
        && d.at is timestamp;
    }
  }
}
